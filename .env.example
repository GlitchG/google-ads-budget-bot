# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Google Ads ──────────────────────────────────────────────
# Developer token from your MCC: Tools & Settings → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth "Desktop app" credential from Google Cloud Console
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Filled automatically by: python get_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account ID, digits only, no dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Telegram ────────────────────────────────────────────────
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Target chat ID (negative for groups). Get it with: python get_chat_id.py
TELEGRAM_CHAT_ID=

# ── Display ─────────────────────────────────────────────────
CURRENCY=$

# ── Schedule (weekly) ───────────────────────────────────────
# IANA timezone for the run, e.g. America/New_York, Europe/London, Asia/Singapore
SCHEDULE_TZ=Your/Timezone
SCHEDULE_DAYS=wed
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# ── Analysis & write behaviour ──────────────────────────────
CONVERSION_LAG_DAYS=2
WOW_DELTA=0.30
NO_CONV_CLICKS=25
SCALE_BUFFER=0.20
MAX_BUDGET_STEP=0.20
# false = advisory only (no account changes). true = allow budget changes via approval buttons.
WRITE_ENABLED=false

# Optional: path to a best-practices Markdown KB (defaults to ./knowledge-base/best-practices.md)
KB_PATH=

# NOTE: edit the ACCOUNTS list in config.py (cid / name / margin / tz / hour).
